# Backend Environment Variables — copy to .env (gitignored, never commit real values)
PORT=5000
SQLITE_PATH=./data/voting.db
REQUEST_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WRITE_MAX=10
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development
# Set to 1 ONLY when running behind exactly one trusted reverse proxy.
# Otherwise req.ip (and rate-limit keys) become attacker-controlled. See docs/SECURITY.md.
TRUST_PROXY=
