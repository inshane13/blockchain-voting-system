# Frontend Environment Variables
# Copy to .env.local and fill in values

# Contract addresses (auto-generated by deploy script)
NEXT_PUBLIC_VOTING_ADDRESS=
NEXT_PUBLIC_VOTER_REGISTRY_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=

# Network configuration
NEXT_PUBLIC_NETWORK_ID=11155111
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Backend audit-log API (dev default http://localhost:5000)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000